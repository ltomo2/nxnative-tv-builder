diff --git a/dm/host/heap_reclaim.h b/dm/host/heap_reclaim.h
new file mode 100644
index 0000000..c3a2d46
--- /dev/null
+++ b/dm/host/heap_reclaim.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+// Only whole pages strictly inside a freed block's payload. Keep the inline
+// 32-byte allocator header and every page shared with an adjacent live block.
+static inline int dm_heap_free_pages(uintptr_t heap, size_t capacity,
+                                     uintptr_t header, size_t payload, size_t page,
+                                     uintptr_t *address, size_t *length) {
+    if (!page || (page & (page - 1)) || capacity > UINTPTR_MAX - heap ||
+        header < heap || header > heap + capacity ||
+        heap + capacity - header < 32 || payload > heap + capacity - header - 32)
+        return 0;
+    uintptr_t start = header + 32, end = start + payload;
+    if (start > UINTPTR_MAX - (page - 1)) return 0;
+    start = (start + page - 1) & ~(uintptr_t)(page - 1);
+    end &= ~(uintptr_t)(page - 1);
+    if (end <= start) return 0;
+    *address = start; *length = end - start;
+    return 1;
+}
diff --git a/dm/host/tests/t_heap_reclaim.c b/dm/host/tests/t_heap_reclaim.c
new file mode 100644
index 0000000..ce6adb2
--- /dev/null
+++ b/dm/host/tests/t_heap_reclaim.c
@@ -0,0 +1,24 @@
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include "heap_reclaim.h"
+int main(void) {
+ size_t p=getpagesize(), n=p*8, len; uintptr_t a;
+ unsigned char *m=mmap(0,n,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0); assert(m!=MAP_FAILED);
+ memset(m,0xa5,n);
+ uintptr_t h=(uintptr_t)m+p+71; size_t size=p*4;
+ assert(dm_heap_free_pages((uintptr_t)m,n,h,size,p,&a,&len));
+ assert(a==(uintptr_t)m+p*2 && len==p*3);
+ assert(!madvise((void*)a,len,MADV_FREE));
+ for(size_t i=0;i<p*2;i++)assert(m[i]==0xa5);
+ for(size_t i=p*5;i<n;i++)assert(m[i]==0xa5);
+ memset((void*)a,0x37,len); for(size_t i=p*2;i<p*5;i++)assert(m[i]==0x37);
+ assert(!dm_heap_free_pages((uintptr_t)m,n,h,p/2,p,&a,&len));
+ assert(!dm_heap_free_pages((uintptr_t)m,n,h,n,p,&a,&len));
+ assert(!dm_heap_free_pages(UINTPTR_MAX-3,8,h,size,p,&a,&len));
+ assert(!dm_heap_free_pages((uintptr_t)m,n,h,size,0,&a,&len));
+ assert(!dm_heap_free_pages((uintptr_t)m,n,h,size,3,&a,&len));
+ munmap(m,n);
+}
diff --git a/dm/gfx/tex/nvn_bc_decode.c b/dm/gfx/tex/nvn_bc_decode.c
new file mode 100644
index 0000000..564e368
--- /dev/null
+++ b/dm/gfx/tex/nvn_bc_decode.c
@@ -0,0 +1,55 @@
+#include "nvn_bc_decode.h"
+#include <string.h>
+#define BCDEC_STATIC
+#define BCDEC_IMPLEMENTATION
+#define BCDEC_BC4BC5_PRECISE
+#include "../../third_party/bcdec/bcdec.h"
+
+unsigned nvn_bc_drop_levels(unsigned w, unsigned h, unsigned levels, unsigned cap) {
+    unsigned drop = 0;
+    if (!cap || !levels) return 0;
+    while (drop + 1 < levels && (w > cap || h > cap)) {
+        w = w > 1 ? w >> 1 : 1; h = h > 1 ? h >> 1 : 1;
+        drop++;
+    }
+    return drop;
+}
+
+size_t nvn_bc_pixel_bytes(int f) {
+    if (f < 0x41 || f > 0x50) return 0;
+    if (f == 0x49 || f == 0x4a) return 1;
+    if (f == 0x4b || f == 0x4c) return 2;
+    return f >= 0x4f ? 8 : 4;
+}
+int nvn_bc_decode(int f, unsigned w, unsigned h, const void *source, size_t source_size, void *destination, size_t pitch) {
+    size_t pixel = nvn_bc_pixel_bytes(f);
+    if (!pixel || !w || !h || !source || !destination || w > SIZE_MAX / pixel || pitch < w * pixel || pitch > SIZE_MAX / h) return -1;
+    size_t nx = ((size_t)w + 3) / 4, ny = ((size_t)h + 3) / 4;
+    size_t block_bytes = (f == 0x41 || f == 0x42 || f == 0x45 || f == 0x46 || f == 0x49 || f == 0x4a) ? 8 : 16;
+    if (nx > SIZE_MAX / block_bytes / ny || source_size < nx * ny * block_bytes) return -1;
+    const uint8_t *src = source; uint8_t *dst = destination;
+    for (size_t by = 0; by < ny; by++) for (size_t bx = 0; bx < nx; bx++) {
+        union { uint64_t align[16]; uint8_t bytes[128]; uint16_t half[64]; } block = {0};
+        union { uint64_t align[2]; uint8_t bytes[16]; } encoded = {0};
+        memcpy(encoded.bytes, src + (by * nx + bx) * block_bytes, block_bytes);
+        const uint8_t *input = encoded.bytes;
+        switch (f) {
+            case 0x41: case 0x42: case 0x45: case 0x46: bcdec_bc1(input, block.bytes, 16); break;
+            case 0x43: case 0x47: bcdec_bc2(input, block.bytes, 16); break;
+            case 0x44: case 0x48: bcdec_bc3(input, block.bytes, 16); break;
+            case 0x49: case 0x4a: bcdec_bc4(input, block.bytes, 4, f == 0x4a); break;
+            case 0x4b: case 0x4c: bcdec_bc5(input, block.bytes, 8, f == 0x4c); break;
+            case 0x4d: case 0x4e: bcdec_bc7(input, block.bytes, 16); break;
+            case 0x4f: case 0x50: {
+                uint16_t rgb[48]; bcdec_bc6h_half(input, rgb, 12, f == 0x4f);
+                for (int i = 0; i < 16; i++) { memcpy(block.half + 4 * i, rgb + 3 * i, 6); block.half[4 * i + 3] = 0x3c00; }
+                break;
+            }
+        }
+        if (f == 0x41 || f == 0x45) for (int i = 0; i < 16; i++) block.bytes[4 * i + 3] = 255;
+        size_t cw = w - bx * 4 < 4 ? w - bx * 4 : 4;
+        size_t ch = h - by * 4 < 4 ? h - by * 4 : 4;
+        for (size_t y = 0; y < ch; y++) memcpy(dst + (by * 4 + y) * pitch + bx * 4 * pixel, block.bytes + y * 4 * pixel, cw * pixel);
+    }
+    return 0;
+}
