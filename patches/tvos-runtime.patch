diff --git a/dm/ios/Sources/tv_shader_pack.c b/dm/ios/Sources/tv_shader_pack.c
new file mode 100644
index 0000000..2bcca47
--- /dev/null
+++ b/dm/ios/Sources/tv_shader_pack.c
@@ -0,0 +1,56 @@
+#include "tv_shader_pack.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <limits.h>
+#include <zlib.h>
+
+static int read_exact(FILE *f, void *p, size_t n) { return fread(p,1,n,f)==n ? 0 : -1; }
+static uint64_t little(const uint8_t *p, unsigned n) { uint64_t v=0; for(unsigned i=0;i<n;i++) v |= (uint64_t)p[i] << (8*i); return v; }
+int tv_shader_unpack(const char *archive_path, const char *directory, void (*progress)(uint64_t, uint64_t)) {
+    FILE *f=fopen(archive_path,"rb"); if(!f) return -1;
+    uint8_t header[20]; int result=-1; uint8_t *buffer=NULL; char output[PATH_MAX];
+    if(read_exact(f,header,sizeof header) || memcmp(header,"NXTVSH01",8)) goto done;
+    uint64_t count=little(header+8,4), expected=little(header+12,8), total=0;
+    if(!count || count>200000 || expected>UINT64_C(16)*1024*1024*1024) goto done;
+    if(mkdir(directory,0700) && errno!=EEXIST) goto done;
+    struct stat ds; if(lstat(directory,&ds) || !S_ISDIR(ds.st_mode)) goto done;
+    buffer=malloc(1024*1024); if(!buffer) goto done;
+    for(uint64_t i=0;i<count;i++) {
+        uint8_t entry[14]; char name[256];
+        if(read_exact(f,entry,sizeof entry)) goto done;
+        size_t length=(size_t)little(entry,2); uint64_t size=little(entry+2,8); uint32_t want=(uint32_t)little(entry+10,4);
+        if(!length || length>=sizeof name || size>64*1024*1024 || size>expected-total || read_exact(f,name,length)) goto done;
+        name[length]=0;
+        if(strlen(name)!=length || name[0]=='.' || strchr(name,'/') || strchr(name,'\\')) goto done;
+        for(size_t j=0;j<length;j++) if(!((name[j]>='a' && name[j]<='z') || (name[j]>='A' && name[j]<='Z') || (name[j]>='0' && name[j]<='9') || name[j]=='_' || name[j]=='-' || name[j]=='.')) goto done;
+        int n=snprintf(output,sizeof output,"%s/%s",directory,name); if(n<0 || (size_t)n>=sizeof output) goto done;
+        int fd=open(output,O_WRONLY|O_CREAT|O_TRUNC|O_NOFOLLOW,0600); if(fd<0) goto done;
+        uint64_t left=size; uint32_t crc=(uint32_t)crc32(0L,Z_NULL,0); int ok=1;
+        while(left) {
+            size_t take=left>1024*1024?1024*1024:(size_t)left;
+            if(read_exact(f,buffer,take)) {ok=0;break;}
+            crc=(uint32_t)crc32(crc,buffer,(uInt)take);
+            size_t offset=0;
+            while(offset<take) { ssize_t w=write(fd,buffer+offset,take-offset); if(w<0 && errno==EINTR) continue; if(w<=0) {ok=0;break;} offset+=(size_t)w; }
+            if(!ok) break; left-=take;
+        }
+        if(close(fd)) ok=0;
+        if(!ok || crc!=want) {unlink(output);goto done;}
+        total+=size;
+        if(i%2000==0 || i+1==count) {
+            fprintf(stderr,"tvOS shaders: unpacked %llu/%llu files\n",(unsigned long long)(i+1),(unsigned long long)count);
+            if(progress) progress(i+1,count);
+        }
+    }
+    if(total!=expected || fgetc(f)!=EOF || ferror(f)) goto done;
+    result=0;
+done:
+    if(result) fprintf(stderr,"tvOS shaders: pack extraction failed\n");
+    free(buffer); fclose(f); return result;
+}
diff --git a/dm/ios/Sources/tv_shader_pack.h b/dm/ios/Sources/tv_shader_pack.h
new file mode 100644
index 0000000..d328811
--- /dev/null
+++ b/dm/ios/Sources/tv_shader_pack.h
@@ -0,0 +1,5 @@
+#pragma once
+#include <stdint.h>
+/* Extract the flat, explicitly versioned shader asset pack. Returns 0 on
+   success, -1 on a malformed pack or filesystem error. Does not delete input. */
+int tv_shader_unpack(const char *archive_path, const char *directory, void (*progress)(uint64_t done, uint64_t total));
